#!/usr/bin/env bash
# nook-tile screenshots: capture, edit in satty, then save to ~/Pictures/Screenshots + clipboard.
#   nook-shot area     pick a region (slurp)            SUPER ⇧ S · PRINT
#   nook-shot window   the focused window               SUPER ⇧ W
#   nook-shot screen   the screen under the cursor      SUPER ⇧ A
#   --quick            skip the editor: save + copy right away   SUPER ⇧ ALT S · SUPER ⇧ PRINT
# In the editor: ⏎ saves, copies and closes, Esc closes without saving (tile/satty/config.toml).
# satty is used when installed natively or as the org.satty.Satty Flatpak; without it, --quick.
set -uo pipefail
mode=area quick=0
for a in "$@"; do
  case "$a" in
    --quick) quick=1 ;;
    area|window|screen) mode=$a ;;
    *) echo "usage: nook-shot [area|window|screen] [--quick]" >&2; exit 2 ;;
  esac
done
dir=$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots
mkdir -p "$dir"
file="$dir/Screenshot_$(date +%Y%m%d_%H%M%S).png"

satty_cmd=()
if command -v satty >/dev/null; then satty_cmd=(satty)
elif flatpak info org.satty.Satty >/dev/null 2>&1; then satty_cmd=(flatpak run org.satty.Satty)
fi
[ ${#satty_cmd[@]} = 0 ] && quick=1

if [ "$quick" = 1 ]; then shot=$file
else
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/nook"
  mkdir -p "$cache"
  shot="$cache/shot-raw.png"
fi

case "$mode" in
  area)   geo=$(slurp -d -b '#0d0d0d88' -c '#45c8e6ff' -s '#45c8e622' -w 2) || exit 0
          grim -g "$geo" "$shot" ;;
  window) geo=$(hyprctl activewindow -j | python3 -I -c 'import json,sys;w=json.load(sys.stdin);print(f"{w[\"at\"][0]},{w[\"at\"][1]} {w[\"size\"][0]}x{w[\"size\"][1]}")') || exit 1
          grim -g "$geo" "$shot" ;;
  screen) out=$(hyprctl monitors -j | python3 -I -c 'import json,sys;print([m["name"] for m in json.load(sys.stdin) if m["focused"]][0])')
          grim -o "$out" "$shot" ;;
esac || { notify-send -a nook -u critical "[!!] screenshot failed" "grim could not capture ($mode)"; exit 1; }

if [ "$quick" = 0 ]; then
  config="${XDG_CONFIG_HOME:-$HOME/.config}/satty/config.toml"
  args=(--filename "$shot" --output-filename "$file")
  [ -f "$config" ] && args+=(--config "$(readlink -f "$config")")
  "${satty_cmd[@]}" "${args[@]}"
  rm -f "$shot"
  [ -f "$file" ] || exit 0
fi

wl-copy --type image/png < "$file"
notify-send -a nook -i "$file" "[OK] screenshot" "${file/#$HOME/~} · in the clipboard" 2>/dev/null || true
