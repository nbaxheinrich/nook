{
  "manifest_version": 3,
  "name": "nook tabs",
  "version": "1.0",
  "description": "Lets the nook launcher list, switch to and close your tabs. Talks only to the local nook-tabs helper.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "nativeMessaging"],
  "background": { "service_worker": "background.js" }
}
