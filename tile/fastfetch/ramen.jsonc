// nook-tile fastfetch (kitty sets NOOK_FASTFETCH to this file).
// Colours are terminal palette names, so kitty's Ramen Sign palette turns them into the neons:
// magenta = rose, red, yellow = gold, green = aqua, cyan, blue.
{
  "logo": {
    "source": "~/.config/fastfetch/ramen-logo.txt",
    "color": { "1": "magenta", "2": "red", "3": "yellow", "4": "green", "5": "cyan", "6": "blue", "7": "bright_yellow" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": { "separator": "  ", "key": { "width": 9 } },
  "modules": [
    "title", "separator",
    { "type": "os",       "key": "os",     "keyColor": "magenta" },
    { "type": "kernel",   "key": "kernel", "keyColor": "red" },
    { "type": "wm",       "key": "wm",     "keyColor": "yellow" },
    { "type": "terminal", "key": "term",   "keyColor": "green" },
    { "type": "shell",    "key": "shell",  "keyColor": "cyan" },
    { "type": "cpu",      "key": "cpu",    "keyColor": "blue", "temp": true },
    { "type": "gpu",      "key": "gpu",    "keyColor": "bright_yellow" },
    { "type": "memory",   "key": "ram",    "keyColor": "bright_green" },
    { "type": "uptime",   "key": "uptime", "keyColor": "bright_blue" },
    "break", "colors"
  ]
}
